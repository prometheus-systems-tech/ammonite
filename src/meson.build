ammonite_deps = [
  cloudproviders,
  config_h,
  gio_unix,
  glycin,
  glycin_gtk4,
  gmodule,
  gnome_autoar,
  gnome_desktop,
  icu_dep,
  icu_i18n_dep,
  libadwaita,
  libgxdp,
  libportal,
  libportal_gtk4,
  ammonite_extension,
  selinux,
  tinysparql,
]

libammonite = static_library(
  'ammonite',
  libammonite_sources,
  dependencies: ammonite_deps,
  include_directories: ammonite_include_dirs,
)

libammonite_include_dirs = include_directories('.')

libammonite_dep = declare_dependency(
  link_with: libammonite,
  include_directories: [ammonite_include_dirs, libammonite_include_dirs],
  dependencies: ammonite_deps,
  # ammonite-main.c, which is part of the main Ammonite executable, uses
  # the header, generated by glib-compile-resources. Passing it on from here
  # will ensure that an internal compile-time dependency is placed on this file,
  # thus avoiding failures that are difficult to reproduce.
  sources: resources_header,
)

ammonite = executable(
  'ammonite',
  'ammonite-main.c',
  dependencies: libammonite_dep,
  install: true,
)

executable(
  'ammonite-autorun-software',
  'ammonite-autorun-software.c',
  include_directories: ammonite_include_dirs,
  dependencies: [
    config_h,
    gtk,
    libadwaita,
  ],
  install: true,
)
