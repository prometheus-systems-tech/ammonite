using Gtk 4.0;
using Adw 1;

template $AmmoniteFilesView: Adw.Bin {
  Overlay overlay {
    hexpand: true;
    vexpand: true;

    [overlay]
    $AmmoniteFloatingBar floating_bar {
      halign: end;
      valign: end;
      spacing: 8;
      show-spinner: bind template.loading;
    }
  }
}
