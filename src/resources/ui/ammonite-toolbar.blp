using Gtk 4.0;
using Adw 1;

template $AmmoniteToolbar: Adw.Bin {
  Adw.HeaderBar {
    [title]
    Box header_toolbar {
      spacing: 6;

      Stack toolbar_switcher {
        valign: center;
        hexpand: false;
        transition-type: crossfade;

        StackPage {
          name: "pathbar";

          child: $AmmonitePathBar path_bar {
            valign: "center";
            window-slot: bind template.window-slot;
          };
        }

        StackPage {
          name: "location";

          child: Box {
            styles [
              "linked",
            ]

            $AmmoniteLocationEntry location_entry {
              // Setting a max width on one entry to effectively set a max expansion for
              // the whole title widget.
              max-width-chars: 88;
              location-changed => $on_location_entry_location_changed();
              cancel => $ammonite_toolbar_close_location_entry() swapped;
            }

            Button {
              icon-name: "window-close-symbolic";
              focus-on-click: false;
              tooltip-text: _("Cancel");
              clicked => $ammonite_toolbar_close_location_entry() swapped;
            }
          };
        }

        StackPage {
          name: "search";

          child: Adw.Bin search_container {};
        }
      }

      Stack search_button_stack {
        hhomogeneous: true;
        transition-type: crossfade;

        ToggleButton search_button {
          tooltip-text: _("Search Current Folder");
          halign: center;
          valign: center;
          action-name: "slot.search-visible";
          icon-name: "ammonite-folder-search-symbolic";
          active: bind template.window-slot as <$AmmoniteWindowSlot>.search-visible;
        }

        Adw.Bin search_button_placeholder {}
      }
    }

    [start]
    ToggleButton show_sidebar_button {
      visible: bind template.show-sidebar-button bidirectional;
      active: bind template.sidebar-button-active bidirectional;
      tooltip-text: _("Show Sidebar");
      icon-name: "sidebar-show-symbolic";
    }

    [start]
    Stack history_controls_stack {
      visible: bind template.show-history-controls;
      hhomogeneous: true;
      transition-type: crossfade;

      $AmmoniteHistoryControls history_controls {
        window-slot: bind template.window-slot;
      }

      Adw.Bin history_controls_placeholder {}
    }

    [end]
    $AmmoniteViewControls {
      visible: bind template.show-view-controls;
      window-slot: bind template.window-slot;
    }

    [end]
    Button new_folder_button {
      visible: bind template.show-new-folder-button;
      icon-name: "folder-new-symbolic";
      tooltip-text: _("New Folder");
      action-name: "view.new-folder";
      focus-on-click: false;
    }
  }
}
